<% if(it.image) { %>
<!-- background image -->
<section id="cover-image">
	<div><span></span></div>
	<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" version="1.1" viewBox="0 0 2560 100" fill="currentColor">
		<polygon points="2560 0 2560 100 0 100" ></polygon>
	</svg>
</section>
<% } %>

<!-- main content -->
<section class="container <%= it.image ? 'image-header' : '' %>">
<%~ it.body %>
</section>

