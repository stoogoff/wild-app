<% layout('../layouts/main', {
	image: false,
}) %>

<main class="header">
	<header>
		<div>
			<img src="/img/cards/<%= it.data.suit.image %>" data-suit="<%= it.data.suit.id %>" />
		</div>
	</header>
	<h1><%= it.data.suit.title %></h1>
	<p><%= it.data.suit.description %></p>

	<!-- card grid -->
	<div class="grid-cols-4" data-q-component="card-grid" data-suit="<%= it.data.suit.id %>">
		<% it.data.cards.forEach(card => { %>
		<figure data-q-click="viewCard" data-card="<%= card.title %>">
			<img src="/img/cards/<%= card.image %>" alt="<%= card.title %>" />
		</figure>
		<% }) %>
	</div>

	<%~ include('../components/card-overlay') %>
</main>

<script type="module">

import { directives } from 'https://cdn.we-evolve.co.uk/js/q/v1.0.0/reactive/directives.js'
import CardGrid from '/js/modules/cards/grid.js'
import CardFlip from '/js/modules/cards/flip.js'

directives.registerComponent('card-grid', CardGrid)
directives.registerComponent('card-flip', CardFlip)
directives.load(document.getElementsByTagName('main')[0])

</script>
