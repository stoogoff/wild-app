<% layout('layouts/main', {
	image: false,
}) %>

<main>
	<h1>Dream Master Reference</h1>
	<section class="sidebar">
		<article>
			<card-filter :value="cards" label="Search Cards" @input="updateGrid" />
			<card-grid :cards="filteredCards" />

			<!-- card filter input -->
			<div class="form-field" data-q-component="card-filter">
				<label for="card-filter">Filter</label>
				<div>
					<input id="card-filter" type="text" data-q-input="filter" data-q-keyup="applyFilter" />
					<span data-q-click="clearFilter"><%~ include('./components/icon', { icon: 'close' }) %></span>
				</div>
			</div>

			<!-- attributes and abilities -->
			<div class="panel">
				<h2>Attributes</h2>
				<div class="grid-cols-2">
					<div>
						<h3>Control</h3>
						<p>Control is about physical dexterity, coordination, accuracy and control.</p>
					</div>
					<div>
						<h3>Strength</h3>
						<p>Strength is all about physical strength, power, force and endurance.</p>
					</div>
					<div>
						<h3>Focus</h3>
						<p>Focus is all about thinking, mental reasoning, emotional restraint, and concentrating.</p>
					</div>
					<div>
						<h3>Passion</h3>
						<p>Passion is all about determination, mental force, emotional strength and imagination.</p>
					</div>
				</div>
			</div>
			<div class="panel">
				<h2>Abilities</h2>
				<div class="grid-cols-2">
					<div>
						<h3>Diplomat</h3>
						<p>The Diplomat Ability is used whenever the character is talking, negotiating, charming, empathising, or understanding someone.</p>
					</div>
					<div>
						<h3>Guardian</h3>
						<p>Guardian comes into play most often when the character is in a physical conflict - shooting, defending, protecting, and fighting.</p>
					</div>
					<div>
						<h3>Rogue</h3>
						<p>Whenever your character is doing something remotely sneaky or underhanded, then Rogue is used.</p>
					</div>
					<div>
						<h3>Scholar</h3>
						<p>The Scholar Ability is used whenever you are doing something that involves information.</p>
					</div>
					<div>
						<h3>Visionary</h3>
						<p>Visionary is a highly creative Ability used whenever your character is making, crafting, planning or creating something.</p>
					</div>
				</div>
			</div>
		</article>

		<!-- card draw and display -->
		<aside data-q-component="card-draw">
			<div class="btn-menu">
				<button class="btn outlined primary block">Draw Cards</button>
				<menu>
					<li data-q-click="draw" data-cards="1">Draw 1</li>
					<li data-q-click="draw" data-cards="2">Draw 2</li>
					<li data-q-click="draw" data-cards="3">Draw 3</li>
					<li data-q-click="draw" data-cards="4">Draw 4</li>
					<li data-q-click="draw" data-cards="5">Draw 5</li>
				</menu>
			</div>

			<div data-q-each="cards">
				<figure data-q-click="viewCard">
					<img class="reversed" data-q-if="isReversed" data-q-src="imagePath" data-q-alt="title" />
					<img data-q-if="!isReversed" data-q-src="imagePath" data-q-alt="title" />
				</figure>
			</div>

			<button class="btn outlined warning small block" data-q-if="canRemoveAll" data-q-click="removeAll">Remove All</button>
		</aside>
	</section>

	<%~ include('./components/card-overlay') %>
</main>
