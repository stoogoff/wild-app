<% layout('../layouts/main', {
	image: false,
}) %>

<main class="header">
	<header>
		<div>
			<img src="/img/cards/<%= it.data.suit.image %>" data-suit="<%= it.data.suit.id %>" />
		</div>
	</header>
	<h1><%= it.data.suit.title %></h1>
	<p><%= it.data.suit.description %></p>
	<card-filter :value="cards" @input="updateGrid"></card-filter>
	<card-grid :cards="filteredCards"></card-grid>

	<div class="grid-cols-4" data-q-component="card-grid" data-suit="<%= it.data.suit.id %>">
		<% it.data.cards.forEach(card => { %>
		<figure data-q-click="viewCard" data-card="<%= card.title %>">
			<img src="/img/cards/<%= card.image %>" alt="<%= card.title %>" />
		</figure>
		<% }) %>
	</div>

	<div class="overlay hidden" data-q-component="card-flip">
		<div class="card-display" data-q-click="flipCard">
			<span class="card-close" data-q-click="closeCard"><svg swidth="24px" height="24px" viewBox="0 0 24 24"><path fill="currentColor" d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" /></svg></span>
			<div class="card">
				<img data-q-class="imageCss" data-q-src="image" />
				<div class="card-back">
					<div>
						<h2 data-q-text="title"></h2>
						<div class="card-info-reversed">&nbsp;<em data-q-if="isReversed">reversed</em>&nbsp;</div>
						<div data-q-class="infoCss"><strong>Key Meaning:</strong> <em data-q-text="keyMeaning"></em></div>
						<div data-q-class="infoCss"><strong>Other Meanings:</strong> <em data-q-text="otherMeanings"></em></div>
						<div data-q-class="infoReversedCss"><strong>Key Reversed Meaning:</strong> <em data-q-text="keyReversedMeaning"></em></div>
						<div data-q-class="infoReversedCss"><strong>Other Reversed Meanings:</strong> <em data-q-text="otherReversedMeaning"></em></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</main>

<script type="module">

//import { DIRECTIVES_LOG_KEY } from 'https://cdn.we-evolve.co.uk/js/q/v1.0.0/reactive/config.js'
//import { setLogger, ConsoleLogger } from 'https://cdn.we-evolve.co.uk/js/q/v1.0.0/utils/logger.js'

import { directives } from 'https://cdn.we-evolve.co.uk/js/q/v1.0.0/reactive/directives.js'
import CardGrid from '/js/modules/cards/grid.js' 
import CardFlip from '/js/modules/cards/flip.js' 

//setLogger(DIRECTIVES_LOG_KEY, ConsoleLogger, 1)

directives.registerComponent('card-grid', CardGrid)
directives.registerComponent('card-flip', CardFlip)
directives.load(document.getElementsByTagName('main')[0])

</script>