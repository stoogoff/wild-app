<% layout('../layouts/main', {
	image: true,
}) %>

<main>
	<h1>The Tarot Deck</h1>
	<section>
		<card-filter :value="cards" @input="updateGrid" />
		<card-grid :cards="filteredCards" />

		<div class="grid-cols-2">
			<% it.data.forEach(suit => { %>
			<figure class="<%= suit.id === 'major-arcana' ? 'col-span-2' : '' %>">
				<a href="/tarot/<%= suit.id %>">
					<img src="/img/cards/<%= suit.image %>" />
					<figcaption>
						<%= suit.title %>
					</figcaption>
				</a>
			</figure>
			<% }) %>
		</div>
	</section>
</main>
